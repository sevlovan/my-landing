@echo off
chcp 65001 >nul
title СУИД — Управление требованиями
cd /d "%~dp0"

echo.
echo ====================================================
echo   СУИД — Реестр функциональных требований
echo ====================================================
echo.
echo Компиляция и запуск приложения...
echo (Это займёт несколько секунд)
echo.

call npm run dev
if %errorlevel% neq 0 (
    echo.
    echo [ОШИБКА] Не удалось запустить приложение.
    echo Убедитесь, что выполнены: npm install
    echo.
    pause
)
